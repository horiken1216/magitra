;
; MtpBth.inf - Magic Trackpad (Bluetooth) driver for MAGITRA (test-signing mode only)
;
; Installs as the function driver on the BTHENUM HID service PDO, replacing hidbth.
; While installed, the trackpad works only through the MAGITRA agent; the MagitraSwitch service
; puts hidbth back while the PC is locked or at the sign-in screen.
; Installed and removed by mtpsetup.exe (advanced option), or by drivers\spike.ps1 for development.
; To revert by hand: pnputil /delete-driver <oemNN.inf> /uninstall
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
CatalogFile = MtpBth.cat
DriverVer   =
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
MtpBth.sys = 1,,

[Manufacturer]
%ProviderName% = Mtp,NT$ARCH$.10.0...16299

[Mtp.NT$ARCH$.10.0...16299]
; PID 0265: Lightning Magic Trackpad. PID 0324: USB-C Magic Trackpad (4th generation, NOT verified on hardware).
%MtpBth.DeviceDesc% = MtpBth_Device, BTHENUM\{00001124-0000-1000-8000-00805f9b34fb}_VID&0001004c_PID&0265
%MtpBth.DeviceDesc% = MtpBth_Device, BTHENUM\{00001124-0000-1000-8000-00805f9b34fb}_VID&0001004c_PID&0324

[MtpBth_Device.NT]
CopyFiles = MtpBth_CopyFiles

[MtpBth_CopyFiles]
MtpBth.sys

[MtpBth_Device.NT.HW]
AddReg = MtpBth_Security_AddReg

[MtpBth_Security_AddReg]
; SYSTEM と Administrators は全権、対話ログオンのユーザー（常駐アプリ）は読み書き
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGW;;;IU)"

[MtpBth_Device.NT.Services]
AddService = MtpBth, 0x00000002, MtpBth_Service

[MtpBth_Service]
DisplayName   = %MtpBth.ServiceDesc%
ServiceType   = 1   ; SERVICE_KERNEL_DRIVER
StartType     = 3   ; SERVICE_DEMAND_START
ErrorControl  = 1   ; SERVICE_ERROR_NORMAL
ServiceBinary = %13%\MtpBth.sys

[MtpBth_Device.NT.Wdf]
KmdfService = MtpBth, MtpBth_wdfsect

[MtpBth_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
ProviderName        = "MAGITRA"
DiskName            = "MAGITRA Installation Disk"
MtpBth.DeviceDesc   = "Magic Trackpad (MAGITRA Bluetooth)"
MtpBth.ServiceDesc  = "MAGITRA Magic Trackpad Bluetooth Driver"
