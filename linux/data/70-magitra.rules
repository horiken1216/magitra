# MAGITRA: ログイン中のユーザーが Magic Trackpad と /dev/uinput を使えるようにする udev ルール。
# TAG+="uaccess" は、ログイン中（アクティブなシートの）ユーザーだけにアクセス権（ACL）を付ける。
# 全ユーザーに開放する MODE="0666" は使わない。
# 規則を入れ替えたら: sudo udevadm control --reload && sudo udevadm trigger

# --- hidraw（マルチタッチの読み取り、振動の書き込み、有効化レポートの送信） ---
# USB 接続（Lightning の 0265、USB-C の 0324）。interface ごとの hidraw すべてに付く
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="05ac", ATTRS{idProduct}=="0265", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="05ac", ATTRS{idProduct}=="0324", TAG+="uaccess"

# Bluetooth 接続。HID デバイス名は <バス>:<VID>:<PID>.<連番>。VID は 004C が普通だが、05AC で見える環境もある
SUBSYSTEM=="hidraw", KERNELS=="0005:004C:0265.*", TAG+="uaccess"
SUBSYSTEM=="hidraw", KERNELS=="0005:004C:0324.*", TAG+="uaccess"
SUBSYSTEM=="hidraw", KERNELS=="0005:05AC:0265.*", TAG+="uaccess"
SUBSYSTEM=="hidraw", KERNELS=="0005:05AC:0324.*", TAG+="uaccess"

# --- /dev/input/event*（EVIOCGRAB でカーネル側のポインター操作を止めるのに開く） ---
# USB 接続
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{idVendor}=="05ac", ATTRS{idProduct}=="0265", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{idVendor}=="05ac", ATTRS{idProduct}=="0324", TAG+="uaccess"

# Bluetooth 接続
SUBSYSTEM=="input", KERNEL=="event*", KERNELS=="0005:004C:0265.*", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", KERNELS=="0005:004C:0324.*", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", KERNELS=="0005:05AC:0265.*", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", KERNELS=="0005:05AC:0324.*", TAG+="uaccess"

# --- /dev/uinput（仮想ポインターと仮想キーボードを作って入力を送る） ---
# static_node=uinput: uinput モジュールが読み込まれる前でも /dev/uinput のノードを用意して ACL を付けられるようにする。
# 注意（セキュリティ）: /dev/uinput を開ける者は、任意のキー入力・マウス操作を、実際のキーボード・マウスと
#   区別できない形でそのセッションに注入できる（他のウィンドウへの入力、端末へのコマンド入力など）。
#   uaccess で「今ログインしている自分のセッション」に限っているが、このユーザーで動くプログラムはすべて使える点に留意すること。
#   共有マシンや信頼できないプログラムを動かす環境では、このルールを入れない判断もある。
KERNEL=="uinput", SUBSYSTEM=="misc", TAG+="uaccess", OPTIONS+="static_node=uinput"
